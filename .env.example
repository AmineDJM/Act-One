# Act One — environment
#
# Short on purpose. Provider API keys, model routing, plans, prices and the
# creative budget are configured in the Super Admin console and stored in the
# database, not here. Everything below is what is needed to BOOT — the keys are
# only a fallback so a fresh deploy works before anybody has signed in.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres. Omit it in development and the app runs against the in-memory store,
# which is a real implementation of the same contract — not a stub — so
# behaviour does not diverge. Required in production; the app refuses to start
# without it.
DATABASE_URL=postgres://user:password@localhost:5432/act_one

# Vault key for provider credentials and customer product logins.
# Generate: node -e "console.log(JSON.stringify({k1:require('crypto').randomBytes(32).toString('base64')}))"
#
# To rotate, ADD a key and move the active pointer. Never replace: old rows are
# decrypted with the key they were written under, and removing it makes every
# stored secret permanently unreadable.
ACT_ONE_SECRET_KEYS={"k1":"<base64-32-bytes>"}
ACT_ONE_SECRET_ACTIVE_KEY=k1

# Canonical origin. Without it, canonical tags, sitemap entries and social card
# URLs all point at localhost — the most common way a launch gets deindexed.
ACT_ONE_SITE_URL=https://yourdomain.com

# ---------------------------------------------------------------------------
# Optional — branding
# ---------------------------------------------------------------------------
ACT_ONE_PRODUCT_NAME=Act One
ACT_ONE_TAGLINE=Your product. Directed.
ACT_ONE_SUPPORT_EMAIL=hello@yourdomain.com

# ---------------------------------------------------------------------------
# Optional — worker
# ---------------------------------------------------------------------------

# Remotion renders with Chrome's OLD headless mode, which current Chrome
# binaries no longer ship — a full `chrome` fails to launch outright. Point this
# at chrome-headless-shell.
ACT_ONE_CHROME_HEADLESS_SHELL=/path/to/chrome-headless-shell

# FFmpeg. Resolution order is this variable, then the bundled ffmpeg-static,
# then PATH. A missing binary is an error rather than a silent fallback to a
# film with no audio.
# ACT_ONE_FFMPEG_PATH=/usr/bin/ffmpeg

# Two concurrent renders per host.
ACT_ONE_WORKER_CONCURRENCY=2

# Chromium for local research, and an inspecting proxy if your egress has one.
# The proxy CA is trusted by SPKI pin, never by disabling certificate
# verification — that would accept any certificate on any site we research.
# ACT_ONE_CHROMIUM_PATH=/path/to/chromium
# ACT_ONE_BROWSER_PROXY=http://proxy:8080
# ACT_ONE_BROWSER_TRUSTED_CA_SPKI=<base64-sha256-spki>

# ---------------------------------------------------------------------------
# Optional — provider fallbacks
# ---------------------------------------------------------------------------
# Set these ONLY to bootstrap a fresh deploy. Once a key is saved in the
# console, the stored one wins.
# OPENAI_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# Higgsfield issues one credential, KEY_ID:KEY_SECRET, at console.higgsfield.ai.
# HF_CREDENTIALS=key-id:key-secret
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=act-one
