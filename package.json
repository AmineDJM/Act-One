{
  "name": "act-one",
  "private": true,
  "version": "0.1.0",
  "description": "Act One — give us your product, get a launch film.",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm --workspace @act-one/web run dev",
    "build": "npm --workspace @act-one/web run build",
    "worker": "npm --workspace @act-one/worker run start",
    "migrate": "node --experimental-strip-types packages/db/src/cli/migrate.ts",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
