{
  "name": "act-one",
  "private": true,
  "version": "0.1.0",
  "description": "Act One \u2014 give us your product, get a launch film.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && npm run check:node",
    "check:node": "node --experimental-strip-types scripts/check-node-loadable.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "NODE_USE_ENV_PROXY=1 npm --workspace @act-one/web run dev",
    "build": "npm --workspace @act-one/web run build",
    "worker": "NODE_USE_ENV_PROXY=1 npm --workspace @act-one/worker run start",
    "migrate": "node --experimental-strip-types packages/db/src/cli/migrate.ts",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "verify": "npm run typecheck && npm run test",
    "demo": "NODE_USE_ENV_PROXY=1 vite-node scripts/demo.ts",
    "reference-films": "NODE_USE_ENV_PROXY=1 vite-node scripts/reference-films.ts",
    "prove:repair-loop": "NODE_USE_ENV_PROXY=1 vite-node scripts/prove-repair-loop.ts",
    "prove:creative-replan": "NODE_USE_ENV_PROXY=1 vite-node scripts/prove-creative-replan.ts",
    "sound-library": "NODE_USE_ENV_PROXY=1 vite-node scripts/build-sound-library.ts",
    "browsers": "node --experimental-strip-types scripts/install-browsers.ts",
    "blender": "node --experimental-strip-types scripts/install-blender.ts",
    "higgsfield:example": "node --experimental-strip-types scripts/higgsfield-example.ts",
    "db:app-role": "node --experimental-strip-types packages/db/src/cli/app-role.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
