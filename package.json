{
  "name": "act-one",
  "private": true,
  "version": "0.1.0",
  "description": "Act One — give us your product, get a launch film.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && npm run check:node",
    "check:node": "node --experimental-strip-types scripts/check-node-loadable.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "NODE_USE_ENV_PROXY=1 npm --workspace @act-one/web run dev",
    "build": "npm --workspace @act-one/web run build",
    "worker": "NODE_USE_ENV_PROXY=1 npm --workspace @act-one/worker run start",
    "migrate": "node --experimental-strip-types packages/db/src/cli/migrate.ts",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "verify": "npm run typecheck && npm run test",
    "demo": "NODE_USE_ENV_PROXY=1 vite-node scripts/demo.ts",
    "reference-films": "NODE_USE_ENV_PROXY=1 vite-node scripts/reference-films.ts",
    "prove:repair-loop": "NODE_USE_ENV_PROXY=1 vite-node scripts/prove-repair-loop.ts",
    "prove:creative-replan": "NODE_USE_ENV_PROXY=1 vite-node scripts/prove-creative-replan.ts",
    "sound-library": "NODE_USE_ENV_PROXY=1 vite-node scripts/build-sound-library.ts",
    "browsers": "node --experimental-strip-types scripts/install-browsers.ts",
    "blender": "node --experimental-strip-types scripts/install-blender.ts",
    "higgsfield:example": "node --experimental-strip-types scripts/higgsfield-example.ts",
    "db:app-role": "node --experimental-strip-types packages/db/src/cli/app-role.ts",
    "prove:director": "NODE_USE_ENV_PROXY=1 vite-node scripts/prove-director.ts",
    "bench:director": "NODE_USE_ENV_PROXY=1 vite-node scripts/bench-director.ts",
    "evaluate:directions": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/evaluate-directions.ts",
    "commission:device": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/commission-device.ts",
    "commission:shot": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/commission-shot.ts",
    "read:audio": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/read-audio.ts",
    "read:targets": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/read-targets.ts",
    "probe": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/probe.ts",
    "launch": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/launch.ts",
    "final": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/final.ts",
    "directions": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/directions.ts",
    "watch:film": "vite-node scripts/watch-film.ts",
    "cast:voices": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/cast-voices.ts",
    "audition": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/audition.ts",
    "commission:output": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/commission-output.ts",
    "sweep:voice": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/sweep-voice.ts",
    "film": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/one-timeline.ts",
    "judge": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/judge-quality.ts",
    "council": "NODE_USE_ENV_PROXY=1 vite-node scripts/film/council.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
